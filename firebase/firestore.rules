// NOTE: this is the copy Firebase CLI actually deploys for this project. It's
// intentionally mirrored at backend/firestore.rules so backend devs can see
// the rules without digging into the Flutter app tree. Nothing enforces they
// stay in sync — after editing either copy, run `npm run check:firestore-rules`
// from backend/ to diff them, and copy your change into the other file.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------- helpers --------------
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid()));
    }
    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }
    // Premium-tier gate (Sep 2026). `tier` defaults to absent/'free' for
    // every user created before this feature — the `'tier' in ...` guard
    // avoids a rules error on those docs rather than silently granting
    // access. Gates Scanner reads and the ADMIN BUYS chat room; see
    // scanner_alerts and chat_rooms/messages below.
    function isPremium() {
      return isSignedIn() && ('tier' in userDoc().data) && userDoc().data.tier == 'premium';
    }
    function isPremiumOrAdmin() {
      return isAdmin() || isPremium();
    }

    // -------------- users --------------
    // A user can read their own doc; admins can read everyone.
    // Users can create/update their own doc but only set role to 'customer'.
    // Admins can write anything.
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.role == 'customer';
      allow update: if isSignedIn() && (
        isAdmin()
        || (
          uid() == userId
          && request.resource.data.role == resource.data.role
        )
      );
      allow delete: if isAdmin();
    }

    // -------------- scanner -------------
    // Public alerts (customer-visible): a signed-in non-admin can only
    // read docs that are BOTH visibility=public AND still_valid !== false.
    // The decay job sets still_valid=false on invalidated cards, and the
    // engine writes admin_only for weak/pre-confirm/WATCH-grade ones.
    // Admins can read everything for moderation.
    //
    // Without these constraints, a malicious user could bypass the Flutter
    // filters and stream all scanner_alerts including admin_only / decayed
    // ones — confusing UX at best, and could expose pre-confirm setups
    // that aren't ready for public consumption.
    //
    // Writes: only admin (or backend service account, which bypasses rules).
    // NOTE: we only enforce `visibility == 'public'` here. Hiding decayed
    // cards (still_valid: false) happens client-side in
    // scanner_repository.dart. We tried enforcing `still_valid != false`
    // at the rule level too, but it blew up every non-admin Scanner tab
    // with permission-denied: Firestore couldn't statically prove the
    // query satisfied the != constraint, and switching the client to
    // `isNotEqualTo: false` would silently exclude every doc missing the
    // field, which would hide all pre-decay-job cards. The client filter
    // alone is sufficient for UX. A user using a raw Firestore client
    // could see decayed cards, but they're harmless and clearly labelled.
    // Sep 2026: Scanner is a premium-only feature. Admins still see
    // everything (including non-public docs, for moderation); premium
    // customers see public docs, same visibility rule as before. Free-tier
    // customers get permission-denied — the Flutter Scanner tab shows a
    // PremiumGate upsell instead of ever issuing this query, so this is a
    // backstop against a client that skips the gate, not the primary UX.
    match /scanner_alerts/{id} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isPremium() && resource.data.visibility == 'public')
      );
      allow write: if isAdmin();
    }

    // Raw scanner output (admin-only).
    match /scanner_results/{id} { allow read, write: if isAdmin(); }
    match /scanner_runs/{id}    { allow read, write: if isAdmin(); }

    // -------------- trade alerts --------
    // Customers see only docs marked visibility = 'public'.
    match /trade_alerts/{id} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.visibility == 'public'
      );
      allow write: if isAdmin();
    }

    // -------------- trades --------------
    match /active_trades/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /closed_trades/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------- performance / recaps --------
    match /performance_stats/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /daily_recaps/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------- chat --------------
    // Room metadata: anyone signed in can read, admins seed/manage.
    // (The backend bumps `lastMessage` via the service account, so admin-write
    //  here is fine - service account bypasses rules.)
    match /chat_rooms/{roomId} {
      // Sep 2026: the admin_buys room's own metadata doc is premium-gated
      // too, so a free-tier user's room list doesn't even resolve its
      // lastMessage preview. Every other room stays open to any signed-in
      // user, unchanged.
      allow read: if isSignedIn() && (
        roomId == 'admin_buys' ? isPremiumOrAdmin() : true
      );
      allow write: if isAdmin();

      // ADMIN BUYS room: admin-only writes, everyone reads + reacts.
      // The room id is hardcoded because it's a special broadcast-only feed.
      //
      // Rules:
      //   - read: any signed-in user (they need to see the screenshots)
      //   - create: admin only (only Boyce Armory posts trades here)
      //   - update: sender (admin) edits caption, OR any signed-in user
      //     editing ONLY the `reactions` field (so users can emoji-react)
      //   - delete: admin only
      //
      // The "reactions-only update" carve-out is the trickier rule. We allow
      // a non-admin update IFF every changed field is `reactions` (and the
      // unchanged fields stay identical to the existing doc).
      match /messages/{messageId} {
        // Limit which fields a non-admin updater can touch on existing messages.
        function reactionsOnlyDiff() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'updatedAt']);
        }

        // Sep 2026: ADMIN BUYS messages are premium-only, same gate as the
        // room doc above. Every other room's messages stay open to any
        // signed-in user.
        allow read: if isSignedIn() && (
          roomId == 'admin_buys' ? isPremiumOrAdmin() : true
        );

        // ADMIN BUYS: only admin can create new messages.
        // All other rooms: any signed-in user can post their own message.
        allow create: if (
          roomId == 'admin_buys'
            ? isAdmin()
              && request.resource.data.senderId == uid()
              && request.resource.data.deleted == false
              && request.resource.data.roomId == roomId
            : isSignedIn()
              && request.resource.data.senderId == uid()
              && request.resource.data.deleted == false
              && request.resource.data.roomId == roomId
        );

        allow update: if isSignedIn() && (
          // Admin can edit anything (caption tweaks, moderation).
          isAdmin()
          // Sender can edit their own message (text rooms).
          || resource.data.senderId == uid()
          // Anyone signed-in can toggle their reaction, but ONLY the
          // reactions field may change. This is how regular users emoji-react
          // to ADMIN BUYS messages without being able to spoof content.
          || reactionsOnlyDiff()
        );

        // Only admin can delete a message. Non-admins cannot delete admin
        // posts, and the broadcast-only nature of ADMIN BUYS means there's
        // never a non-admin message in that room to delete.
        allow delete: if isAdmin();
      }
    }

    // -------------- notifications -----
    // System-generated notification feed. Read for any signed-in user (the
    // app filters to "yours"); writes only via service account / admin.
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------------- device tokens -----
    // A user can register / update / remove their own FCM token. Admins can
    // read for moderation. Token is the doc id so we tie it to a uid via
    // the `uid` field.
    match /device_tokens/{token} {
      allow read: if isSignedIn() && (
        isAdmin()
        || (resource == null)
        || resource.data.uid == uid()
      );
      allow create: if isSignedIn() && request.resource.data.uid == uid();
      allow update: if isSignedIn() && (
        isAdmin() || resource.data.uid == uid()
      );
      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.uid == uid()
      );
    }

    // -------------- queues / logs (admin-only) ----------
    match /push_queue/{id}    { allow read, write: if isAdmin(); }
    match /discord_queue/{id} { allow read, write: if isAdmin(); }
    match /admin_logs/{id}    { allow read, write: if isAdmin(); }

    // Deny-by-default for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
