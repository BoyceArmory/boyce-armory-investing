<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Boyce Armory</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>boyce_armory</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!--
	  Privacy usage descriptions — REQUIRED by App Store review.
	  Missing any of these for a capability the app's code references
	  (image_picker → camera/photos) will:
	  1. Cause a runtime crash the first time the capability is invoked
	  2. Trigger automatic rejection by App Store static analysis
	-->
		<key>NSCameraUsageDescription</key>
		<string>Boyce Armory uses the camera so you can take and upload a profile photo.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Boyce Armory needs access to your photos so you can choose a profile picture.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Boyce Armory can save chart screenshots and shared content to your photo library.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Boyce Armory does not currently use the microphone. This entry is required because the image_picker library can request it on iOS.</string>
		<!--
	  Note: SceneDelegate.swift exists but is intentionally not referenced
	  by a UIApplicationSceneManifest. iOS falls back to AppDelegate-based
	  lifecycle which FlutterAppDelegate handles end-to-end. To enable
	  scene-aware features (Stage Manager, multi-window iPad) later,
	  add a UIApplicationSceneManifest block pointing at SceneDelegate.
	-->
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!--
	  Universal device family (iPhone + iPad) is REQUIRED — version 2.0(6)
	  shipped to App Store Connect as universal, and Apple rejects upload
	  attempts that drop a previously-supported device family
	  (error 90101 / QA1623). The iPad layout for now is a scaled-up phone
	  view; the demo-seed alerts + EmptyAlertCard ensure both Hot Trades
	  and Scanner show content on iPad so reviewers never see a blank
	  page. Future release will add iPad-optimized layouts.
	-->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	</dict>
</plist>
