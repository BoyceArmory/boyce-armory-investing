<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Boyce Armory</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>boyce_armory</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!--
	  Privacy usage descriptions — REQUIRED by App Store review.
	  Missing any of these for a capability the app's code references
	  (image_picker → camera/photos) will:
	  1. Cause a runtime crash the first time the capability is invoked
	  2. Trigger automatic rejection by App Store static analysis
	-->
		<key>NSCameraUsageDescription</key>
		<string>Boyce Armory uses the camera so you can take and upload a profile photo.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Boyce Armory needs access to your photos so you can choose a profile picture.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Boyce Armory can save chart screenshots and shared content to your photo library.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Boyce Armory does not currently use the microphone. This entry is required because the image_picker library can request it on iOS.</string>
		<!--
	  Note: SceneDelegate.swift exists but is intentionally not referenced
	  by a UIApplicationSceneManifest. iOS falls back to AppDelegate-based
	  lifecycle which FlutterAppDelegate handles end-to-end. To enable
	  scene-aware features (Stage Manager, multi-window iPad) later,
	  add a UIApplicationSceneManifest block pointing at SceneDelegate.
	-->
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIBackgroundModes</key>
		<array>
			<string>fetch</string>
			<string>remote-notification</string>
		</array>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!--
	  Device family: iPhone only.
	  App Store Connect submission 2.0(6) was reviewed on iPad Air 11" (M3)
	  and rejected under Guideline 2.1(a) because "Hot" and "Scanner" pages
	  did not load - the iPad layout pushed content off-screen. Restricting
	  to iPhone tells Apple to only review the device family we actually
	  support. We'll add iPad-optimized layouts in a future release before
	  re-enabling iPad.
	-->
		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
		</array>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
	</dict>
</plist>
