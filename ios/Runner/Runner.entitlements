<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Push notifications.
	  - "development" for debug / TestFlight internal builds.
	  - The App Store distribution provisioning profile automatically
	    overrides this to "production" on archive, so this single value
	    works for both dev and release.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
